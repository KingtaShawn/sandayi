<!-- pages/home/home.wxml —— 首页 -->
<view class="home">
  <view class="home__logo">
    <text class="home__title">{{isSanDaYi ? '三打一' : '升级'}}</text>
    <text class="home__subtitle">{{isSanDaYi ? '1 庄 vs 3 家 · 报分 90 起' : '80 分 · 升级'}}</text>
  </view>

  <view class="home__progress" wx:if="{{hasHistory && !isSanDaYi}}">
    <text class="home__progress-item">我方：打 {{myLevel}}</text>
    <text class="home__progress-item">敌方：打 {{enemyLevel}}</text>
  </view>

  <view class="home__actions">
    <view class="home__start btn btn--primary" bind:tap="onStart">
      <text>开始对局</text>
    </view>
    <view class="home__secondary">
      <view class="btn btn--ghost" bind:tap="onRules">
        <text>规则速查</text>
      </view>
      <view class="btn btn--ghost" bind:tap="onLeaderboard">
        <text>排行榜</text>
      </view>
      <view class="btn btn--ghost" bind:tap="onSettings">
        <text>设置</text>
      </view>
    </view>
  </view>

  <view class="home__stats" wx:if="{{statsText}}">
    <text class="home__stats-text">{{statsText}}</text>
  </view>

  <!-- 云账号状态行 -->
  <view class="home__cloud">
    <text class="home__cloud-text">{{cloudText}}</text>
    <view class="btn btn--ghost home__cloud-btn" bind:tap="onCloud">
      <text>账号</text>
    </view>
  </view>
</view>

<!-- 云账号弹层（游客升级 / 换设备登录） -->
<view class="cmodal" wx:if="{{cloudModal}}">
  <view class="cmodal__mask" bind:tap="onCloudClose"></view>
  <view class="cmodal__panel">
    <text class="cmodal__title">云账号</text>
    <text class="cmodal__hint">{{cloudHint}}</text>
    <input class="cmodal__input" placeholder="用户名（2~16位中文/字母/数字）" maxlength="16" value="{{formName}}" bindinput="onNameInput" />
    <input class="cmodal__input" placeholder="密码（4~32位）" maxlength="32" password value="{{formPass}}" bindinput="onPassInput" />
    <input class="cmodal__input" wx:if="{{cloudIsGuest}}" placeholder="确认密码（升级时填）" maxlength="32" password value="{{formPass2}}" bindinput="onPass2Input" />
    <view class="cmodal__actions">
      <view class="btn btn--ghost cmodal__btn {{submitting ? 'btn--disabled' : ''}}" bind:tap="onLogin">
        <text>{{cloudIsGuest ? '登录已有账号' : '切换到此账号'}}</text>
      </view>
      <view class="btn btn--primary cmodal__btn {{submitting ? 'btn--disabled' : ''}}" wx:if="{{cloudIsGuest}}" bind:tap="onBind">
        <text>升级为正式账号</text>
      </view>
    </view>
    <text class="cmodal__foot">升级后换手机/浏览器登录同一账号，战绩不丢</text>
    <view class="btn btn--ghost cmodal__close" bind:tap="onCloudClose">
      <text>关闭</text>
    </view>
  </view>
</view>

<!-- 排行榜弹层（满分庄家榜） -->
<view class="cmodal" wx:if="{{lbModal}}">
  <view class="cmodal__mask" bind:tap="onLbClose"></view>
  <view class="cmodal__panel cmodal__panel--lb">
    <text class="cmodal__title">满分庄家榜</text>
    <text class="cmodal__hint cmodal__hint--sub">你坐庄独揽 200 分的次数 · 全网玩家</text>
    <scroll-view class="cmodal__list" scroll-y>
      <view wx:if="{{lbEmpty}}" class="cmodal__empty">
        <text>{{lbEmpty}}</text>
      </view>
      <view wx:for="{{lbList}}" wx:key="index" class="cmodal__row {{item.isMe ? 'cmodal__row--me' : ''}}">
        <text class="cmodal__rank">{{item.rank}}</text>
        <text class="cmodal__nick">{{item.nick}}</text>
        <text class="cmodal__count">满分 {{item.maxBids}} 次</text>
      </view>
    </scroll-view>
    <view class="btn btn--ghost cmodal__close" bind:tap="onLbClose">
      <text>关闭</text>
    </view>
  </view>
</view>
