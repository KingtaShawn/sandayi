<!-- pages/home/home.wxml —— 首页 -->
<view class="home">
  <view class="home__logo">
    <text class="home__title">拖拉机</text>
    <text class="home__subtitle">80 分 · 升级</text>
  </view>

  <view class="home__progress" wx:if="{{hasHistory}}">
    <text class="home__progress-item">我方：打 {{myLevel}}</text>
    <text class="home__progress-item">敌方：打 {{enemyLevel}}</text>
  </view>

  <view class="home__resume" wx:if="{{hasResumable}}">
    <view class="btn btn--primary" bind:tap="onResume">
      <text>继续对局（第 {{resumeRound}} 局）</text>
    </view>
  </view>

  <view class="home__actions">
    <view class="home__start btn btn--primary" bind:tap="onStart">
      <text>开始对局</text>
    </view>
    <view class="home__secondary">
      <view class="btn btn--ghost" bind:tap="onRules">
        <text>规则速查</text>
      </view>
      <view class="btn btn--ghost" bind:tap="onSettings">
        <text>设置</text>
      </view>
    </view>
  </view>

  <view class="home__stats" wx:if="{{statsText}}">
    <text class="home__stats-text">{{statsText}}</text>
  </view>
</view>
