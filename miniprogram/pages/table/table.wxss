/* pages/table/table.wxss —— v1.1：四方位环绕布局 */
@import '/app.wxss';

.table {
  height: 100vh;
  background: radial-gradient(circle at 50% 30%, #12904f, #0b6b3a 70%, #074f2c);
  display: flex;
  flex-direction: column;
  padding: 12rpx 12rpx 24rpx;
  box-sizing: border-box;
}

/* 北家：顶部中央 */
.table__north {
  display: flex;
  justify-content: center;
  margin-bottom: 8rpx;
}

/* 中部：西 | 中 | 东 三栏 */
.table__mid {
  flex: 1;
  display: flex;
  align-items: stretch;
  gap: 8rpx;
  min-height: 0;
}

/* 东西侧栏：垂直居中 */
.table__side {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex-shrink: 0;
}

/* 中央区：纵向排 状态栏 + 出牌区 */
.table__center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  min-width: 0;
}

/* 工具条 */
.table__tools {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 16rpx;
  margin: 6rpx 0;
}

.table__tool-btn {
  padding: 10rpx 36rpx;
  font-size: 24rpx;
}

/* v1.1 主牌信息胶囊 */
.table__trump-chip {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.32);
  border: 2rpx solid rgba(243, 193, 75, 0.5);
  color: var(--color-gold);
  font-size: 24rpx;
  font-weight: 600;
}

/* v1.1 收墩飘分层（覆盖中央，不挡交互） */
.table__float-layer {
  position: absolute;
  top: 40%;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  pointer-events: none;
  z-index: 10;
}

.table__float-points {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--color-gold);
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.5), 0 0 20rpx rgba(243, 193, 75, 0.6);
}

.table__hand {
  background: rgba(0, 0, 0, 0.18);
  border-radius: 16rpx;
}

.table__actions {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  padding: 12rpx 0 0;
}

/* v1.7 三打一：底牌明示区（低叫分时公开） */
.table__bottom-reveal {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 4rpx;
}

.table__bottom-reveal-label {
  font-size: 20rpx;
  color: var(--color-gold);
  margin-bottom: 4rpx;
}

.table__bottom-reveal-cards {
  display: flex;
  align-items: center;
}

/* v1.7 三打一：叫分气泡 */
.table__bid-bubbles {
  position: absolute;
  top: 8rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 12rpx;
  z-index: 5;
}

.table__bid-bubble {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #5c3d00;
  background: linear-gradient(180deg, #f7d478, #f3c14b);
  border: 2rpx solid #caa235;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.25);
}
