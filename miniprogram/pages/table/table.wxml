<!-- pages/table/table.wxml —— 牌桌页 v1.1（四方位环绕布局） -->
<view class="table">
  <!-- 顶部：北家（升级=队友 / 三打一=对手） -->
  <view class="table__north">
    <seat-info player-idx="{{2}}" name="{{players[2].name}}" hand-count="{{players[2].handCount}}"
      is-dealer="{{dealerIdx === 2}}" is-turn="{{turnIdx === 2}}" camp-label="{{players[2].campLabel}}"
      bid-score="{{seatBids[2].score}}" bid-pass="{{seatBids[2].pass}}" is-bottom-owner="{{bottomOwnerIdx === 2}}" />
  </view>

  <!-- 中部：西家 | 中央出牌区 | 东家 -->
  <view class="table__mid">
    <view class="table__side">
      <seat-info vertical player-idx="{{3}}" name="{{players[3].name}}" hand-count="{{players[3].handCount}}"
        is-dealer="{{dealerIdx === 3}}" is-turn="{{turnIdx === 3}}" camp-label="{{players[3].campLabel}}"
        bid-score="{{seatBids[3].score}}" bid-pass="{{seatBids[3].pass}}" is-bottom-owner="{{bottomOwnerIdx === 3}}" />
    </view>

    <view class="table__center">
      <status-bar
        trump-text="{{trumpText}}"
        my-score="{{myScore}}"
        enemy-score="{{enemyScore}}"
        my-score-label="{{myScoreLabel}}"
        enemy-score-label="{{enemyScoreLabel}}"
        game-mode="{{gameMode}}"
        contract-score="{{contractScore}}"
        round-no="{{roundNo}}"
        trick-info="{{trickInfo}}"
      />
      <trick-area current-trick="{{currentTrick}}" bottom-count="{{bottomCount}}" level-rank="{{levelRank}}" dim="{{lastTrickDim}}" />
      <!-- v2.0 QQ 风格发牌动画：中央牌堆 + 四向轮发飞牌（absolute 覆盖中央区，pointer-events 穿透） -->
      <view class="deal-anim" wx:if="{{dealAnim.active}}">
        <view class="deal-anim__deck">
          <view class="deal-anim__deck-card deal-anim__deck-card--3"></view>
          <view class="deal-anim__deck-card deal-anim__deck-card--2"></view>
          <view class="deal-anim__deck-card deal-anim__deck-card--1"></view>
        </view>
        <view class="deal-anim__fly deal-anim__fly--s{{item.seat}}" wx:for="{{dealAnim.flyCards}}" wx:key="id"></view>
      </view>
      <!-- v2.1 三打一抓底牌动画：中央 8 张底牌展示（真人庄家翻面亮出看清牌面，AI 庄家牌背）→ 逐张飞向庄家座位 -->
      <view class="grab-anim" wx:if="{{grabBottom.active}}">
        <view class="grab-anim__glow"></view>
        <view class="grab-anim__pile">
          <view class="grab-anim__cards">
            <!-- 真人庄家：翻面亮出（face 为 Page 预计算牌面；card 组件样式隔离，此处页面自行渲染） -->
            <view
              wx:if="{{grabBottom.reveal}}"
              class="grab-anim__card grab-anim__card--face {{grabBottom.stage === 'fly' && index < grabBottom.flyCount ? 'grab-anim__card--gone' : ''}}"
              wx:for="{{grabBottom.cards}}"
              wx:key="id"
              style="animation-delay: {{item.delay}}ms"
            >
              <view class="grab-face {{item.face.red ? 'grab-face--red' : 'grab-face--black'}} {{item.card.isTrump ? 'grab-face--trump' : ''}}">
                <view class="grab-face__corner">
                  <text class="grab-face__rank">{{item.face.rank}}</text>
                  <text class="grab-face__suit">{{item.face.suit}}</text>
                </view>
              </view>
            </view>
            <view
              wx:else
              class="grab-anim__card {{grabBottom.stage === 'fly' && index < grabBottom.flyCount ? 'grab-anim__card--gone' : ''}}"
              wx:for="{{grabBottom.cards}}"
              wx:key="id"
              style="animation-delay: {{item.delay}}ms"
            ></view>
          </view>
          <view class="grab-anim__label" wx:if="{{grabBottom.stage === 'show' || grabBottom.flyCount < grabBottom.cards.length}}">{{grabBottom.reveal && grabBottom.stage === 'show' ? '底牌已翻开' : '底牌 ×' + grabBottom.cards.length}}</view>
        </view>
        <!-- 飞牌：复用发牌动画 deal-fly 四向关键帧（庄家座位方向） -->
        <view class="deal-anim__fly deal-anim__fly--s{{item.seat}}" wx:for="{{grabBottom.flyCards}}" wx:key="id"></view>
      </view>
      <!-- v1.7 三打一：低叫分时底牌明示（QQ 规则：叫 60/65 闲家可看） -->
      <view class="table__bottom-reveal" wx:if="{{bottomRevealCards.length && gameMode === 'san_da_yi'}}">
        <text class="table__bottom-reveal-label">底牌（公开）</text>
        <view class="table__bottom-reveal-cards">
          <block wx:for="{{bottomRevealCards}}" wx:key="id">
            <card card="{{item}}" style-text="margin-left: {{index === 0 ? 0 : -30}}rpx" />
          </block>
        </view>
      </view>
      <!-- v1.1 收墩飘分 -->
      <view class="table__float-layer">
        <view class="table__float-points {{floatPoints.anim ? 'anim-float-up' : ''}}" wx:if="{{floatPoints.visible}}">
          <text>{{floatPoints.text}}</text>
        </view>
      </view>
    </view>

    <view class="table__side">
      <seat-info vertical player-idx="{{1}}" name="{{players[1].name}}" hand-count="{{players[1].handCount}}"
        is-dealer="{{dealerIdx === 1}}" is-turn="{{turnIdx === 1}}" camp-label="{{players[1].campLabel}}"
        bid-score="{{seatBids[1].score}}" bid-pass="{{seatBids[1].pass}}" is-bottom-owner="{{bottomOwnerIdx === 1}}" />
    </view>
  </view>

  <!-- 工具条 -->
  <view class="table__tools">
    <view class="btn btn--ghost table__tool-btn" bind:tap="onHint">
      <text>提示</text>
    </view>
    <view class="table__trump-chip" wx:if="{{trumpChipText}}">{{trumpChipText}}</view>
    <view class="btn btn--ghost table__tool-btn" bind:tap="onHistory">
      <text>历史</text>
    </view>
  </view>

  <!-- 操作条（报分/选主/埋底/出牌）已统一移至手牌下方 table__action-slot，避免阶段切换抖动 -->

  <!-- 我方手牌 -->
  <view class="table__hand">
    <hand-area
      hand="{{myHand}}"
      level-rank="{{levelRank}}"
      trump-suit="{{trumpSuit}}"
      selected-ids="{{selectedIds}}"
      glowing-ids="{{glowingIds}}"
      lift-ids="{{liftIds}}"
      play-in-ids="{{playInIds}}"
      visible-count="{{handVisibleCount}}"
      label="{{handLabel}}"
      bind:cardtap="onCardTap"
    />
  </view>

  <!-- 操作条插槽：固定高度，阶段内（报分/选主/埋底/出牌）互斥切换，高度恒定不抖动 -->
  <view class="table__action-slot">
    <bid-bar
      visible="{{!dealAnim.active && !grabBottom.active && (phase === 'BIDDING' && isHumanTurnBid || phase === 'CHOOSE_TRUMP' && isHumanChooseTrump)}}"
      mode="{{bidMode}}"
      options="{{bidOptionsView}}"
      score-options="{{scoreOptionsView}}"
      suit-options="{{suitOptionsView}}"
      tip-text="{{bidTipText}}"
      pass-label="{{passLabel}}"
      bind:bid="onBid"
      bind:scorebid="onScoreBid"
      bind:chooseTrump="onChooseTrump"
      bind:pass="onPassBid"
    />
    <bury-bar
      visible="{{phase === 'BURYING' && isHumanDealer}}"
      need-count="{{needBuryCount}}"
      selected-count="{{selectedIds.length}}"
      bind:confirm="onBuryConfirm"
    />
    <block wx:if="{{phase === 'PLAYING' && turnIdx === 0}}">
      <view class="btn btn--primary {{(selectedIds.length > 0 && selectedIds.length === needPlayCount) ? 'anim-pulse' : 'btn--disabled'}}" bind:tap="onPlay">
        <text>出牌</text>
      </view>
      <view class="btn btn--ghost" bind:tap="onClearSelect">
        <text>重选</text>
      </view>
    </block>
  </view>

  <!-- 结算弹层 -->
  <result-modal
    visible="{{phase === 'SCORING' || phase === 'GAME_OVER'}}"
    banner="{{settleBanner}}"
    is-win="{{settleIsWin}}"
    mode="{{gameMode}}"
    dealer-points="{{settle.dealerPoints}}"
    attacker-points="{{settle.attackerPoints}}"
    contract-score="{{settle.contractScore}}"
    penalty-total="{{settle.penaltyTotal}}"
    attack-points="{{settle.attackPoints}}"
    bottom-gained="{{settle.bottomGained}}"
    bottom-multiplier="{{settle.bottomMultiplierUsed}}"
    levels-gained="{{settle.levelsGained}}"
    my-level="{{levels.team0}}"
    enemy-level="{{levels.team1}}"
    bottom-cards="{{settleBottomCards}}"
    game-over="{{phase === 'GAME_OVER'}}"
    bind:next="onNextRound"
    bind:home="onHome"
  />

  <!-- 历史弹层 -->
  <history-modal
    visible="{{historyVisible}}"
    tricks="{{historyTricks}}"
    bind:close="onHistoryClose"
  />
</view>
