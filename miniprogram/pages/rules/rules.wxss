/* pages/rules/rules.wxss */
@import '/app.wxss';

.rules {
  min-height: 100vh;
  background: #f2efe6;
  padding: 24rpx;
  box-sizing: border-box;
}

.rules__section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rules__h2 {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c5f3a;
  margin-bottom: 6rpx;
}

.rules__li {
  font-size: 25rpx;
  color: #444;
  line-height: 1.7;
}

.rules__table {
  margin-top: 8rpx;
  border: 2rpx solid #e3ddcf;
  border-radius: 12rpx;
  overflow: hidden;
}

.rules__row {
  display: flex;
}

.rules__row--head {
  background: #e8f2e9;
}

.rules__cell {
  flex: 1;
  text-align: center;
  font-size: 23rpx;
  padding: 10rpx 4rpx;
  color: #3a4a3a;
  border-bottom: 2rpx solid #efeadf;
}
