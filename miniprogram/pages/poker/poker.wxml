<view class="poker"><view class="topbar"><view bindtap="back">← 游戏大厅</view><view>♠ 德州扑克 · 无限注</view><picker range="{{counts}}" value="{{count}}" bindchange="count">AI {{counts[count]}} ▾</picker></view><view class="heading"><view><view class="eyebrow">THE HOLD’EM ROOM</view><view class="title">德州扑克</view><view class="subtitle">无限注 · 盲注 10 / 20 · 游戏筹码</view></view><picker range="{{counts}}" value="{{count}}" bindchange="count">AI {{counts[count]}} ▾</picker></view>
<view class="table-wrap"><view class="table"><view class="felt"><view class="dealer"><view class="dealer-avatar"><view class="dealer-face"></view><view class="dealer-body">♠</view></view><view class="dealer-label">荷官 · DEALER</view></view><view class="center"><view class="pot">底池 · {{pot}}</view><view class="chips">● ● ●</view><view class="cards board"><text wx:for="{{board}}" wx:key="*this" style="animation-delay: {{index * 230}}ms">{{item}}</text></view><view class="status">{{status}}</view></view></view><view wx:for="{{players}}" wx:key="name" class="seat {{item.active?'active':''}} {{item.action==='弃牌'?'folded':''}}" style="{{item.style}}"><view class="avatar">{{item.avatar}}</view><view class="seat-info"><view class="seat-name">{{item.name}}<text wx:if="{{item.position}}" class="seat-position">{{item.position}}</text></view><view class="seat-chips">◈ {{item.chips}}</view><view class="seat-action">{{item.action||'等待'}}</view></view><view wx:if="{{item.dealer}}" class="button-dealer">D</view><view wx:if="{{item.cards}}" class="seat-cards">{{item.cards}}</view><view wx:if="{{item.bet}}" class="seat-bet">◉ {{item.bet}}</view></view><view class="player"><view class="player-label"><view class="eyebrow">YOUR HAND</view><view>你的手牌</view></view><view class="cards hand"><text wx:for="{{hole}}" wx:key="*this" style="animation-delay: {{index * 230}}ms">{{item}}</text></view></view></view></view>
<view class="controls"><view class="controls-title">行动区 <text>加注金额为本轮累计投入</text></view><view class="actions"><button disabled="{{!human}}" data-type="fold" bindtap="act">弃牌</button><button disabled="{{!human}}" data-type="call" bindtap="act">{{call?'跟注 '+call:'过牌'}}</button><input type="number" value="{{amount}}" bindinput="input" placeholder="加注至"/><button disabled="{{!human||!canRaise}}" data-type="raise" bindtap="act">加注</button><button disabled="{{!human||!canRaise}}" data-type="allin" bindtap="act">全押</button><button disabled="{{!canNext}}" bindtap="next">发下一手</button><button bindtap="reset">重新开桌</button></view></view></view>
