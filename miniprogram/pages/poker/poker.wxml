<view class="poker"><view class="topbar"><view bindtap="back">← 游戏大厅</view><view>♠ 德州扑克 · 无限注</view><picker range="{{counts}}" value="{{count}}" bindchange="count">AI {{counts[count]}} ▾</picker></view><view class="heading"><view><view class="eyebrow">THE HOLD’EM ROOM</view><view class="title">德州扑克</view><view class="subtitle">无限注 · 盲注 10 / 20 · 游戏筹码</view></view><picker range="{{counts}}" value="{{count}}" bindchange="count">AI {{counts[count]}} ▾</picker></view>
<view class="table-wrap"><view class="table"><view class="felt"><view class="dealer"><view class="dealer-avatar"><image src="/assets/poker-dealer.jpg" mode="aspectFill" aria-label="AI 女荷官" /></view><view class="dealer-label">荷官 · DEALER</view></view><view class="center"><view class="pot">底池 · {{pot}}</view><view class="chips"><view wx:for="{{potStacks}}" wx:key="id" class="chip-stack {{item.colour}}"><view></view><view></view><view></view></view></view><view class="cards board"><text wx:for="{{board}}" wx:key="*this" class="{{motionBoardFrom >= 0 && index >= motionBoardFrom ? (motionPending ? 'deal-wait' : (motionReady && boardMotion[index] ? 'deal-directional' : '')) : ''}}" style="{{boardMotion[index]}}">{{item}}</text></view><view class="status">{{status}}</view></view></view><view wx:for="{{players}}" wx:key="name" class="seat {{players.length===9?'dense':''}} {{item.winner?'winner':''}} {{item.active?'active':''}} {{item.status}} {{item.revealed?'showdown':''}}" style="{{item.style}}"><view class="avatar">{{item.avatar}}</view><view class="seat-info"><view class="seat-name">{{item.name}}<text wx:if="{{item.position}}" class="seat-position">{{item.position}}</text></view><view class="seat-chips">◈ {{item.chips}}</view><view class="seat-action">{{item.action||'等待'}}</view></view><view wx:if="{{item.award}}" class="seat-award {{settling?'award-animate':''}}">+{{item.award}}</view><view wx:if="{{item.dealer}}" class="button-dealer">D</view><view wx:if="{{item.cards}}" class="seat-cards {{item.revealed?'revealed':''}}"><text wx:if="{{item.revealed}}">{{item.cards}}</text><block wx:else><text wx:for="{{[0,1]}}" wx:for-item="back" wx:for-index="backIndex" wx:key="*this" data-seat-index="{{index}}" data-card-index="{{backIndex}}" class="seat-card-back {{motionHand ? (motionPending ? 'deal-wait' : (motionReady && seatMotion[index] && seatMotion[index][backIndex] ? 'deal-directional' : '')) : ''}}" style="{{seatMotion[index] ? seatMotion[index][backIndex] : ''}}"></text></block></view><view wx:if="{{item.bet}}" class="seat-bet">◉ {{item.bet}}</view></view><view class="chip-flights"><view wx:for="{{betFlights}}" wx:key="id" class="flying-chips bet-flight" style="{{item.style}}"><view></view><view></view><view></view></view><view wx:for="{{payoutFlights}}" wx:key="id" class="flying-chips payout-flight" style="{{item.style}}"><view></view><view></view><view></view></view></view><view class="player"><view class="player-label"><view class="eyebrow">YOUR HAND</view><view>你的手牌</view></view><view class="cards hand"><text wx:for="{{hole}}" wx:key="*this" class="{{motionHand ? (motionPending ? 'deal-wait' : (motionReady && handMotion[index] ? 'deal-directional' : '')) : ''}}" style="{{handMotion[index]}}">{{item}}</text></view></view></view></view>
<view class="controls"><view class="controls-title">行动区 <text>加注金额为本轮累计投入</text></view><view class="actions"><button disabled="{{!human}}" data-type="fold" bindtap="act">弃牌</button><button disabled="{{!human}}" data-type="call" bindtap="act">{{call?'跟注 '+call:'过牌'}}</button><button class="sizing" bindtap="openSizing" disabled="{{!human||!canRaise}}">{{sizingLabels[sizingIndex]}} ▾</button><button disabled="{{!human||!canRaise}}" data-type="raise" bindtap="act">{{raiseTo?'加注至 '+raiseTo:'加注'}}</button><button disabled="{{!human||!canRaise}}" data-type="allin" bindtap="act">全押</button><button disabled="{{!canNext}}" bindtap="next">发下一手</button><button bindtap="reset">重新开桌</button></view></view><view wx:if="{{sizingOpen}}" class="sizing-overlay" bindtap="closeSizing"><view class="sizing-dialog" catchtap="noop"><view class="sizing-head"><view><view class="sizing-eyebrow">BET SIZE</view><view class="sizing-title">选择加注尺度</view></view><button class="sizing-close" bindtap="closeSizing">×</button></view><view class="sizing-options"><button wx:for="{{sizingOptions}}" wx:key="index" class="{{item.selected?'selected':''}}" data-index="{{item.index}}" bindtap="selectSizing"><view>{{item.label}}</view><text>加至 {{item.target}}</text></button></view><view class="sizing-note">按实际金额递增，自动遵守最小加注和剩余筹码</view></view></view></view>
