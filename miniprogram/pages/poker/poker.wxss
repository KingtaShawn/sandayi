.poker{box-sizing:border-box;min-height:100vh;padding:28rpx 20rpx 70rpx;background:#101d18;color:#efe9d9}.heading{display:flex;justify-content:space-between;align-items:flex-end}.eyebrow{color:#d2ad6d;font-size:18rpx;letter-spacing:4rpx}.title{font-size:48rpx;font-weight:bold;letter-spacing:5rpx;margin:10rpx 0}.subtitle{color:#a9b8a8;font-size:22rpx}.heading picker{color:#ddcda8;font-size:22rpx}.table-wrap{padding:160rpx 60rpx 115rpx}.table{position:relative;height:750rpx;border:18rpx solid #553b2c;border-radius:48%;background:#164a38;box-shadow:0 0 0 5rpx #bc9661,0 18rpx 30rpx #0008}.felt{position:absolute;inset:12rpx;border:2rpx solid #c5a775;border-radius:48%;background:radial-gradient(ellipse,#28745a,#0b3b2d);text-align:center}.dealer{position:absolute;top:-150rpx;left:50%;transform:translateX(-50%);z-index:4}.dealer-avatar{position:relative;overflow:hidden;width:100rpx;height:100rpx;border:4rpx solid #d8bd81;border-radius:45% 45% 30% 30%;background:#4c3027}.dealer-face{position:absolute;left:32rpx;top:12rpx;width:36rpx;height:42rpx;background:#ecc09d;border-radius:45%}.dealer-body{position:absolute;bottom:-20rpx;left:12rpx;width:76rpx;height:60rpx;border-radius:50% 50% 0 0;background:#1b2921;color:#d8b574;font-size:18rpx}.dealer-label{white-space:nowrap;padding:3rpx 8rpx;background:#17251f;border:1rpx solid #ad9061;font-size:18rpx}.center{position:absolute;top:38%;left:8%;width:84%}.pot{color:#f1d59c;font-size:22rpx}.chips{color:#dbb76d;font-size:28rpx;margin:14rpx}.status{color:#e3dfc8;font-size:20rpx;margin-top:18rpx}.seat{position:absolute;transform:translate(-50%,-50%);display:flex;align-items:center;gap:6rpx;width:130rpx;padding:6rpx;border:2rpx solid #8c7550;border-radius:45rpx;background:#1a3025;box-shadow:0 5rpx 16rpx #0008;z-index:3}.seat.active{border-color:#f4cf7e;box-shadow:0 0 0 5rpx #dcb46255}.seat.folded{opacity:.55}.avatar{display:flex;align-items:center;justify-content:center;flex:none;width:40rpx;height:40rpx;border-radius:50%;background:#a67b4e;color:#fff3db;font-size:22rpx}.seat-info{font-size:16rpx;line-height:1.25;white-space:nowrap}.seat-name{font-size:19rpx}.seat-chips{color:#e2bb72}.seat-action{color:#c2cfc0}.button-dealer{position:absolute;right:0;top:-16rpx;width:28rpx;height:28rpx;background:#fff9e8;border-radius:50%;color:#333;text-align:center;font-size:20rpx}.seat-cards,.seat-bet{position:absolute;left:50%;top:100%;transform:translateX(-50%);font-size:20rpx;color:#eee4d3;white-space:nowrap}.seat-bet{top:calc(100% + 26rpx);color:#f0d493;font-size:17rpx}.cards{display:flex;justify-content:center;gap:8rpx;min-height:95rpx}.cards text{display:flex;align-items:center;justify-content:center;width:68rpx;height:94rpx;border-radius:8rpx;background:#fffdfa;color:#18251e;font-size:27rpx;font-weight:bold;box-shadow:0 5rpx 12rpx #0006;animation:deal .55s ease both}.player{display:flex;align-items:center;justify-content:center;gap:30rpx;margin-bottom:30rpx}.player-label{font-size:26rpx;font-weight:bold}.controls{padding:24rpx;background:#192a22;border:2rpx solid #9c8052;border-radius:18rpx}.controls-title{font-size:26rpx;color:#e9d7b5;margin-bottom:20rpx}.controls-title text{float:right;color:#99aa9b;font-size:19rpx}.actions{display:flex;flex-wrap:wrap;gap:10rpx}.actions button{font-size:24rpx;padding:0 18rpx;margin:0;background:#355744;color:#fff}.actions button[disabled]{opacity:.4}.actions input{box-sizing:border-box;background:#0f1c16;color:white;border:1rpx solid #617768;border-radius:8rpx;padding:12rpx;width:135rpx;height:65rpx;font-size:23rpx}.rules,.log{color:#aab8aa;font-size:21rpx;line-height:1.8;margin-top:24rpx}@keyframes deal{from{opacity:0;transform:translateY(-220rpx) rotate(-20deg) scale(.4)}to{opacity:1;transform:none}}
page{height:100%;overflow:hidden}.poker{height:100vh;min-height:0;padding:0;overflow:hidden;position:relative}.topbar{height:9vh;display:flex;align-items:center;justify-content:space-between;padding:0 3vw;font-size:3vh;color:#e9d7b5;border-bottom:1px solid #ffffff22}.heading{display:none}.table-wrap{position:absolute;left:0;top:9vh;width:71vw;height:91vh;padding:0}.table{position:absolute;left:10%;right:10%;top:19%;bottom:13%;height:auto;border-width:1.6vh}.felt{inset:1vh}.dealer{top:-16vh}.dealer-avatar{width:11vh;height:11vh;border-width:1px}.dealer-face{width:38%;height:40%;top:12%;left:31%}.dealer-body{width:78%;height:55%;bottom:-13%;left:11%;font-size:2vh}.dealer-label{font-size:2vh}.center{top:38%}.pot,.status{font-size:2.5vh}.chips{font-size:3vh;margin:1vh}.cards{min-height:0;gap:1vh}.cards text{width:9vh;height:12vh;font-size:3vh}.seat{width:auto;padding:.6vh 1vh .6vh .6vh;gap:.6vh}.avatar{width:6vh;height:6vh;font-size:2.8vh}.seat-info{font-size:1.8vh}.seat-name{font-size:2.3vh}.button-dealer{top:-2vh;width:4vh;height:4vh;font-size:2.5vh}.seat-cards{font-size:2vh}.seat-bet{top:calc(100% + 4vh);font-size:1.8vh}.player{position:absolute;left:72vw;right:2vw;top:10vh;height:25vh;margin:0;gap:1vw}.player-label{font-size:2.7vh}.eyebrow{font-size:1.7vh;letter-spacing:1px}.controls{position:absolute;left:72vw;right:2vw;top:37vh;bottom:2vh;padding:1.5vh 1vw;overflow:hidden}.controls-title{font-size:2.8vh;margin-bottom:1vh}.controls-title text{display:none}.actions{display:grid;grid-template-columns:1fr 1fr;gap:1vh}.actions button{width:100%;height:7vh;line-height:7vh;font-size:2.6vh;padding:0}.actions input{width:100%;height:7vh;font-size:2.6vh;padding:1vh}.rules,.log{display:none}
.cards text{animation-duration:.95s;animation-timing-function:cubic-bezier(.18,.7,.22,1)}
.seat-position{font-size:1.7vh;color:#f4dfab;background:#715a34;border-radius:3px;padding:1px 3px;margin-left:3px;font-weight:600}
.table-wrap{width:80vw}.table{left:8%;right:8%;top:18%;bottom:11%}.player{position:absolute;z-index:4;left:50%;right:auto;top:70%;height:auto;transform:translateX(-50%);margin:0}.player-label{display:none}.hand text{width:8vh;height:11vh}.controls{left:80vw;right:1.5vw;top:13vh;bottom:3vh;padding:1.5vh .8vw}.actions{grid-template-columns:minmax(0,1fr);gap:.65vh}.actions button,.actions input{height:7.3vh;line-height:7.3vh}
.center{top:28%}
.seat.in-hand,.seat.all-in,.seat.survived,.seat.ready{opacity:1;border-color:#77e6a3;background:#265a3d;box-shadow:0 0 0 3rpx #69d99655,0 5rpx 16rpx #0008}.seat.in-hand .avatar,.seat.all-in .avatar,.seat.survived .avatar,.seat.ready .avatar{border:2rpx solid #9af4b7}.seat.in-hand .seat-action,.seat.all-in .seat-action,.seat.survived .seat-action,.seat.ready .seat-action{color:#b7ffcd;font-weight:bold}.seat.active{border-color:#ffe08a;background:#625021;box-shadow:0 0 0 5rpx #f4d47a99,0 0 18rpx #d9b45088}.seat.folded,.seat.eliminated{opacity:.43;filter:grayscale(.7);border-color:#777;background:#222b26}
.chips{height:5vh;min-height:12px;display:flex;align-items:flex-end;justify-content:center;gap:1vh;margin:1vh 0}.chip-stack{position:relative;width:4.1vh;height:100%}.chip-stack view{position:absolute;left:0;bottom:0;width:100%;height:2.2vh;border:2px dashed #f5e8cf;border-radius:50%;background:#e5c68b;box-shadow:0 2px 3px #001b17aa}.chip-stack view:nth-child(2){bottom:.7vh}.chip-stack view:nth-child(3){bottom:1.4vh}.chip-stack.red view{background:#be5244}.chip-stack.blue view{background:#4287a7}.chip-stack.gold view{background:#d6a83d}.chip-stack.green view{background:#4ba276}.chip-flights{position:absolute;inset:0;z-index:8;pointer-events:none}.flying-chips{position:absolute;left:50%;top:40%;width:5vh;height:3vh;pointer-events:none}.flying-chips view{position:absolute;width:4.4vh;height:2.4vh;border-radius:50%;border:2px dashed #fff1ce;background:#d9af53}.flying-chips view:nth-child(2){top:-.6vh;left:.5vh;background:#bd5346}.flying-chips view:nth-child(3){top:-1.2vh;left:1vh;background:#448ba4}.payout-flight{animation:payout-travel 1.05s cubic-bezier(.3,.02,.18,1) both}.bet-flight{animation:bet-travel .85s cubic-bezier(.3,.02,.18,1) both}.seat.winner{border-color:#ffd87f;box-shadow:0 0 0 4rpx #edbf5f88,0 0 18rpx #e8b44f77}.seat-award{position:absolute;top:-3vh;left:50%;transform:translateX(-50%);color:#fff2bd;background:#745729;border:1px solid #eec86f;border-radius:9px;padding:1px 5px;font-size:2.5vh;font-weight:bold;white-space:nowrap}.seat-award.award-animate{animation:award-pop .7s ease both}@keyframes payout-travel{0%{opacity:0;transform:scale(.6)}15%{opacity:1}75%{opacity:1}100%{opacity:0;transform:translate(var(--dx),var(--dy)) scale(.65)}}@keyframes bet-travel{0%{opacity:0;transform:translate(var(--dx),var(--dy)) scale(.6)}15%{opacity:1}75%{opacity:1}100%{opacity:0;transform:scale(.65)}}@keyframes award-pop{from{opacity:0;transform:translate(-50%,1vh) scale(.7)}to{opacity:1;transform:translate(-50%,0) scale(1)}}
.seat.winner{z-index:6}.seat-award{left:110%}
.actions .sizing{height:7.3vh;line-height:7.3vh;box-sizing:border-box;padding:0 .6vw;border:1px solid #617768;border-radius:5px;background:#10231a;color:#f9edce;font-size:2.2vh;white-space:nowrap}.seat.eliminated.showdown{opacity:1;filter:none}.seat-cards.revealed{background:#fffdfa;border:1px solid #dac8a5;border-radius:3px;color:#17221e;padding:1px 3px}
.seat-cards.revealed{font-size:2.8vh;font-weight:bold;padding:2px 4px}
.actions button.sizing{height:7.3vh;line-height:7.3vh;text-align:left;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;padding:0 .7vw;background:#10231a;color:#f9edce;font-size:2.2vh}
.sizing-overlay{position:absolute;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;background:#07120fc9}.sizing-dialog{box-sizing:border-box;width:78vw;max-height:90vh;padding:4vh 3vw;background:#183325;border:1px solid #d2ae6c;border-radius:10px;color:#f6ecd8;box-shadow:0 14px 42px #000a}.sizing-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:3vh}.sizing-eyebrow{font-size:2vh;letter-spacing:2px;color:#d2ad6d}.sizing-title{font-size:4vh;font-weight:bold;margin-top:.7vh}.sizing-close{width:8vh;height:8vh;line-height:8vh;border:1px solid #8b9d8f;border-radius:50%;padding:0;margin:0;background:#243e31;color:white;font-size:5vh}.sizing-options{display:flex;gap:1vw}.sizing-options button{flex:1;min-width:0;height:24vh;line-height:1.2;padding:3vh 0;border:1px solid #66846e;border-radius:8px;background:#1c382b;color:#f2ebd8;font-size:3vh;white-space:nowrap}.sizing-options button.selected{border-color:#f2cc7b;background:#5e4b27}.sizing-options button text{display:block;margin-top:2vh;font-size:2.5vh;color:#efcf8e}.sizing-note{text-align:center;font-size:2vh;color:#b4c7b5;margin-top:3vh}
.sizing-options button::after,.sizing-close::after,.actions button.sizing::after{border:0}
