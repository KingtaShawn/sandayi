<view class="lobby">
  <view class="brand">✦ 游戏小院</view>
  <view class="lobby-main">
    <view class="title">今天，玩点什么？</view>
    <view class="entries">
      <button class="entry poker" bindtap="onPoker" aria-label="进入德州扑克"><text class="icon" aria-hidden="true">♠</text><text class="name">德州扑克</text></button>
      <button class="entry cards" bindtap="onCards" aria-label="进入三打一"><text class="icon" aria-hidden="true">♥</text><text class="name">三打一</text></button>
      <button class="entry fruit" bindtap="onMatch3" aria-label="进入果园消消乐"><text class="icon" aria-hidden="true">🍎</text><text class="name">果园消消乐</text></button>
      <button class="entry stars" bindtap="onPopstar" aria-label="进入消灭星星"><text class="icon" aria-hidden="true">★</text><text class="name">消灭星星</text></button>
    </view>
  </view>
  <view class="footer">单人畅玩 · 随时切换</view>
</view>
