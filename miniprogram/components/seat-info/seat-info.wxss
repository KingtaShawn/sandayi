/* components/seat-info/seat-info.wxss —— v1.1：竖排模式 + 思考气泡 + 庄家浮动徽标 */
@import '/app.wxss';

.seat-info {
  position: relative;
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.22);
  border-radius: 16rpx;
  padding: 10rpx 16rpx;
  border: 2rpx solid transparent;
  transition: border-color var(--anim-fast), box-shadow var(--anim-fast);
}

.seat-info--turn {
  border-color: var(--color-primary);
  box-shadow: 0 0 16rpx rgba(243, 193, 75, 0.4);
}

/* v1.1 竖排（东西家）：纵向堆叠居中 */
.seat-info--vertical {
  flex-direction: column;
  padding: 12rpx 10rpx;
  gap: 6rpx;
}

.seat-info--vertical .seat-info__meta {
  align-items: center;
  min-width: 0;
}

.seat-info--vertical .seat-info__name {
  font-size: 22rpx;
}

.seat-info__avatar {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #4f9d6d, #2c6e49);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.seat-info--vertical .seat-info__avatar {
  width: 56rpx;
  height: 56rpx;
}

.seat-info--vertical .seat-info__avatar-text {
  font-size: 22rpx;
}

.seat-info__avatar-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

/* v1.1 庄家徽标（头像右上角浮动） */
.seat-info__dealer-badge {
  position: absolute;
  top: -8rpx;
  right: -10rpx;
  font-size: 18rpx;
  line-height: 1;
  padding: 5rpx 8rpx;
  border-radius: 999rpx;
  background: var(--color-danger);
  color: #fff;
  font-weight: 700;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  z-index: 2;
}

.seat-info__meta {
  display: flex;
  flex-direction: column;
  min-width: 100rpx;
}

.seat-info__name {
  color: var(--color-text-light);
  font-size: 24rpx;
  font-weight: 600;
}

.seat-info__cards {
  color: var(--color-text-dim);
  font-size: 20rpx;
}

/* v1.1 思考气泡（三点跳动） */
.seat-info__thinking {
  display: flex;
  gap: 6rpx;
  align-items: center;
  padding: 6rpx 12rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.25);
}

.seat-info--vertical .seat-info__thinking {
  padding: 4rpx 10rpx;
}

.seat-info__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #0b6b3a;
}

.seat-info__badge {
  font-size: 18rpx;
  line-height: 1;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  color: #fff;
}

.seat-info__badge--turn {
  background: var(--color-primary);
  color: #5c3d00;
}

/* v1.6 阵营标签（三打一：对手红标） */
.seat-info__camp {
  font-size: 18rpx;
  line-height: 1;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.15);
  color: var(--color-text-dim);
}

.seat-info__camp--foe {
  background: rgba(229, 77, 66, 0.35);
  color: #ffb3ad;
  border: 1rpx solid rgba(229, 77, 66, 0.5);
}

.seat-info--vertical .seat-info__camp {
  font-size: 16rpx;
  padding: 3rpx 8rpx;
}
