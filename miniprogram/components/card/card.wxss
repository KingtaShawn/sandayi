/* components/card/card.wxss —— v1.1：精修牌面（王牌设计/分牌角标/主牌金边/选中态） */
@import '/app.wxss';

.card {
  position: relative;
  width: var(--card-w);
  height: var(--card-h);
  border-radius: var(--radius-card);
  background: var(--color-card-bg);
  border: 2rpx solid var(--color-card-border);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--anim-fast), box-shadow var(--anim-fast);
  flex-shrink: 0;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.22);
}

.card--red {
  color: var(--color-red);
}

.card--black {
  color: var(--color-black);
}

/* 主牌金边高亮 */
.card--trump {
  border-color: var(--color-gold);
  box-shadow: 0 0 0 2rpx rgba(243, 193, 75, 0.55), 0 2rpx 6rpx rgba(0, 0, 0, 0.22);
}

.card--selected {
  transform: translateY(-24rpx);
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.35);
  border-color: var(--color-primary);
}

.card--disabled {
  opacity: 0.35;
  filter: grayscale(0.8);
}

.card__corner {
  position: absolute;
  top: 6rpx;
  left: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card__corner--flip {
  top: auto;
  left: auto;
  bottom: 6rpx;
  right: 8rpx;
  transform: rotate(180deg);
}

.card__rank {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.1;
}

.card__suit {
  font-size: 24rpx;
  line-height: 1.1;
}

/* ========== v1.2 紧凑模式（手牌 >24 张） ========== */
.card--dense {
  width: 64rpx;
  height: 96rpx;
  border-radius: 8rpx;
}

.card--dense .card__rank {
  font-size: 24rpx;
}

.card--dense .card__suit {
  font-size: 20rpx;
}

.card--dense .card__corner {
  top: 4rpx;
  left: 4rpx;
}

/* ========== v1.2 王：边角星形+正/副显示（大王=★正 红 / 小王=☆副 黑） ========== */
/* 星占牌面位（rank 行）、正/副占花色位——结构与普通牌完全同构，dense 下随全局字号缩放 */
.card__rank--joker {
  font-size: 30rpx;
  line-height: 1.1;
}

/* 小王空心星描边微加粗，避免小字号下空心轮廓不清 */
.card--joker .card__rank--joker {
  font-weight: 700;
  text-shadow: 0 0 2rpx currentColor;
}

.card--dense .card__rank--joker {
  font-size: 24rpx;
}

/* ========== v1.1 王牌底色（星形角标版保留淡金/淡橙底以示区分） ========== */
.card--joker {
  background: linear-gradient(160deg, #fffef7 0%, #ffe9b8 100%);
}

.card--joker-big {
  background: linear-gradient(160deg, #fff5f3 0%, #ffd9c2 55%, #ffb98a 100%);
}

/* ========== v1.1 分牌角标（5/10/K 分值徽章） ========== */
.card__point-badge {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  min-width: 28rpx;
  padding: 2rpx 6rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #f7d478, #e8a92f);
  border: 2rpx solid #b8860b;
  color: #5c3d00;
  font-size: 18rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.2;
  z-index: 2;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.25);
}

/* ========== 呼吸金光（glowing=true：新抓底牌并入高亮 4.2s，看清与手牌的配合） ========== */
/* z-index 提层防右侧叠牌遮挡光晕；动画不 forwards——glowingIds 清空摘类即熄 */
@keyframes card-glow {
  0%, 100% { box-shadow: 0 0 6rpx rgba(243, 193, 75, 0.3); }
  50% { box-shadow: 0 0 17rpx rgba(243, 193, 75, 0.95); }
}

.anim-glow {
  z-index: 2;
  animation: card-glow 1.1s ease-in-out infinite;
}

/* ========== v2.2 抬高停顿（新抓底牌，腾讯升级式） ========== */
/* 插到所属花色排序位后整体抬起（比选中态 -24rpx 更高，不混淆），金边示新；
 * .card 自带 transform transition，摘类即平滑落回 */
.card--lift {
  transform: translateY(-40rpx);
  border-color: var(--color-gold);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.3), 0 0 8rpx rgba(243, 193, 75, 0.4);
  z-index: 2;
}
